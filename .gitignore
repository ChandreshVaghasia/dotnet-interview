# .gitignore for a .NET (SDK-style) solution (safe, merged)

# Visual Studio / IDE
.vs/
.vscode/
.idea/

# User-specific files
*.suo
*.user
*.userprefs
*.sln.docstates
*.userosscache

# Build outputs
/bin/
*/bin/
**/bin/
/obj/
*/obj/
**/obj/

# Build configurations / architecture
[Dd]ebug/
[Rr]elease/
x64/
x86/

# NuGet / MSBuild generated files
project.assets.json
project.nuget.cache
*.csproj.nuget.dgspec.json
*.csproj.nuget.g.props
*.csproj.nuget.g.targets
*.nupkg
packages/

# Test output / coverage
/TestResults/
/coverage/

# Local DBs and DB journals
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs and caches
*.log
*.cache

# Publish / deployment artifacts
*.publishsettings
*.deployment

# OS files
Thumbs.db
.DS_Store